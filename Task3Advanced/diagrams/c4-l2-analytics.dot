digraph Analytics {
  graph [charset="UTF-8", rankdir=TB, bgcolor="#F8FAFC", pad=0.3,
    nodesep=0.53, ranksep=0.65, splines=polyline, newrank=true,
    fontname="Arial", fontsize=23, fontcolor="#10253F", labelloc=t,
    label=<<B>C4 · Контейнеры · Целевая архитектура через 36 месяцев</B><BR/><FONT POINT-SIZE="14">Доменные продукты данных и самостоятельная аналитика</FONT>>];
  node [shape=box, style="rounded,filled", margin="0.16,0.12", fontname="Arial", fontsize=11,
    color="#88A8C8", fillcolor="#E7F1FB", fontcolor="#10253F", penwidth=1.2];
  edge [fontname="Arial", fontsize=9, fontcolor="#344F67", color="#52718B", arrowsize=0.65];

  analyst [label=<<B>Аналитики и владельцы продуктов</B><BR/><FONT POINT-SIZE="8">Роли · поиск данных, отчёты и KPI</FONT>>, fillcolor="#F1F5F9", color="#94A3B8"];
  kpi [label=<<B>Офис KPI</B><BR/><FONT POINT-SIZE="8">Роль · методики, владельцы и версии метрик</FONT>>, fillcolor="#F1F5F9", color="#94A3B8"];
  { rank=same; analyst; kpi; }

  subgraph cluster_platform {
    label=<<B>Платформа данных компании</B>>;
    fontname="Arial"; fontsize=12; fontcolor="#173B64"; labeljust=l;
    style="rounded,filled"; color="#91ABBE"; fillcolor="#FFFFFF"; margin=21;

    subgraph cluster_stream {
      label=<<B>Региональные потоки</B>>; style="rounded,filled"; color="#A9C8BF"; fillcolor="#F1F8F6"; margin=16;
      kafka [id="kafka", URL="c4-l2-operational.svg#kafka", tooltip="Открыть вид операционных доменов",
        label=<<B>Шина событий</B><BR/><FONT POINT-SIZE="8">Контейнер · Apache Kafka</FONT><BR/>Темы по домену и региону · ACL>, fillcolor="#DEF1EB", color="#6E9E91"];
      schema [id="schema", label=<<B>Реестр схем</B><BR/><FONT POINT-SIZE="8">Контейнер · Schema Registry</FONT><BR/>Разрешённые схемы и версии>, fillcolor="#DEF1EB", color="#6E9E91"];
      projector [id="projector", URL="c4-l3-domain-stream-projector.svg", tooltip="Открыть компоненты проектора",
        label=<<B>Проектор доменного потока</B><BR/><FONT POINT-SIZE="8">Контейнер · Apache Flink</FONT><BR/>Валидация и построение проекций>, fillcolor="#CBE9DF", color="#448471", penwidth=1.6];
      { rank=same; kafka; projector; schema; }
      kafka -> projector [label="Доменные события\nKafka consumer"];
      projector -> schema [label="Схема по ID · REST", style=dashed, color="#697E94"];
    }

    subgraph cluster_products {
      label=<<B>Продукты данных</B>>; style="rounded,filled"; color="#A9C8BF"; fillcolor="#F1F8F6"; margin=16;
      products [label=<<B>Таблицы доменных продуктов</B><BR/><FONT POINT-SIZE="8">Хранилище · S3 / Apache Iceberg</FONT><BR/>Клиники, ИИ, банк, фарма, медоборудование<BR/>Витрины по регионам и доменам>, fillcolor="#DEF1EB", color="#6E9E91"];
      nessie [label=<<B>Технический каталог</B><BR/><FONT POINT-SIZE="8">Контейнер · Project Nessie</FONT><BR/>Ссылки на таблицы и версии Iceberg>, fillcolor="#DEF1EB", color="#6E9E91"];
      { rank=same; products; nessie; }
    }

    subgraph cluster_access {
      label=<<B>Доступ к данным</B>>; style="rounded,filled"; color="#C7C8E3"; fillcolor="#F5F4FB"; margin=16;
      trino [label=<<B>Защищённый SQL</B><BR/><FONT POINT-SIZE="8">Контейнер · Trino / Iceberg connector</FONT><BR/>Доступ по ролям, доменам и регионам<BR/>Фильтры строк и маскирование колонок>, color="#9899C6", fillcolor="#ECECF9"];
      datahub [label=<<B>Каталог для поиска</B><BR/><FONT POINT-SIZE="8">Контейнер · DataHub</FONT><BR/>Описание наборов, владельцы, lineage<BR/>Глоссарий KPI и условия доступа>, color="#9899C6", fillcolor="#ECECF9"];
      portal [label=<<B>Портал самостоятельной BI</B><BR/><FONT POINT-SIZE="8">Контейнер · веб-портал / конструктор отчётов</FONT><BR/>Отчёты по согласованным моделям и KPI>, color="#7779B1", fillcolor="#DFE0F5", penwidth=1.6];
      idp [label=<<B>Провайдер идентификации</B><BR/><FONT POINT-SIZE="8">Контейнер · корпоративный IdP</FONT><BR/>Вход, группы, роли>, color="#9899C6", fillcolor="#ECECF9"];
      { rank=same; trino; datahub; }
      { rank=same; portal; idp; }
      trino -> portal [label="Запросы к витринам · SQL\nС идентификацией пользователя", dir=back, arrowtail=normal, arrowhead=none, color="#6C6A9B"];
      portal -> idp [label="Вход · OIDC", color="#6C6A9B"];
      datahub -> portal [label="Поиск наборов и KPI · API", dir=back, arrowtail=normal, arrowhead=none, color="#6C6A9B"];
    }

    projector -> products [label="Запись разрешённых проекций\nIceberg commit / S3"];
    projector -> nessie [label="Обновление каталога\nIceberg / Nessie API"];
    products -> trino [label="Чтение разрешённых таблиц · S3", dir=back, arrowtail=normal, arrowhead=none];
    nessie -> trino [label="Версии таблиц · Nessie API", dir=back, arrowtail=normal, arrowhead=none];
    nessie -> datahub [label="Инвентарь и метаданные\nконнектор каталога"];
    trino -> datahub [label="Lineage SQL · ingestion", style=dashed, color="#697E94"];
  }

  portal -> analyst [label="Создаёт и открывает отчёты · HTTPS", dir=back, arrowtail=normal, arrowhead=none, color="#6C6A9B"];
  datahub -> kpi [label="Утверждённые определения\nи владельцы KPI · HTTPS", dir=back, arrowtail=normal, arrowhead=none, color="#6C6A9B"];

  note [shape=note, fillcolor="#FFF7ED", color="#C89264", fontcolor="#713C16",
    label="Kafka, доменные продукты и BI получают разрешённые поля.\nМедкарты, истории и содержимое результатов ИИ остаются в исходных контурах."];
  analyst -> note [style=invis];
  kpi -> note [style=invis];
}
