digraph bounded_contexts {
  graph [
    charset="UTF-8", rankdir=LR, newrank=true, splines=polyline,
    bgcolor="white", pad=0.22, nodesep=0.48, ranksep=0.42,
    fontname="Arial", fontsize=22, fontcolor="#172539", labelloc=t,
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3">
        <TR><TD>Карта ограниченных контекстов</TD></TR>
        <TR><TD><FONT POINT-SIZE="11">Событие от поставщика U к потребителю D · опубликованный язык (PL)</FONT></TD></TR>
        <TR><TD><FONT POINT-SIZE="10">OHS · опубликованный интерфейс домена     ACL · адаптация на стороне потребителя</FONT></TD></TR>
        <TR><TD><FONT POINT-SIZE="10">Фиолетовый · клинический канал     Охра · внутренний канал банка     Зелёный · утверждённая аналитика     Пунктир · внешние связи</FONT></TD></TR>
      </TABLE>
    >
  ];
  node [
    shape=box, style="rounded,filled", color="#7d91a6", fillcolor="#f0f5fa",
    fontname="Arial", fontsize=11, fontcolor="#172539", margin="0.14,0.10"
  ];
  edge [
    color="#647990", arrowsize=0.65, penwidth=1.2,
    fontname="Arial", fontsize=10, fontcolor="#30445b"
  ];

  register_staff [label="Регистраторы\nи пациенты", fillcolor="white"];
  clinicians [label="Врачи", fillcolor="white"];
  billing_staff [label="Расчётчики клиник", fillcolor="white"];
  bank_clients [label="Клиенты и\nсотрудники банка", fillcolor="white"];
  pharma_partner [label="Будущий партнёр\nФармпоставщик", fillcolor="white"];
  device_partner [label="Будущие партнёры\nПроизводитель и сервис", fillcolor="white"];
  hq [label="Головной офис", fillcolor="white"];

  subgraph cluster_clinical {
    label="Клинический контур"; style="rounded,filled"; color="#cbb8df"; fillcolor="#faf7fd";
    fontname="Arial"; fontsize=12; fontcolor="#56376e";
    CLINIC [label="CLINIC\nРегистратура", fillcolor="#f1e6fa", color="#9d7eb6"];
    EHR [label="EHR\nКлиническая документация", fillcolor="#f1e6fa", color="#9d7eb6"];
    AI [label="AI\nМедицинский ИИ", fillcolor="#f1e6fa", color="#9d7eb6"];
    CLINIC -> EHR [label="VisitRegistered", color="#8655a5", fontcolor="#653780"];
    EHR:se -> AI:sw [label="ClinicalStudyRequested", color="#8655a5", fontcolor="#653780"];
    AI:nw -> EHR:ne [label="AIStudyCompleted", color="#8655a5", fontcolor="#653780", constraint=false];
  }

  BILL [label="BILL\nВыставление счетов клиники"];
  subgraph cluster_bank {
    label="Банковский контур"; labelloc=b; style="rounded,filled"; color="#e1c78c"; fillcolor="#fdfaf0";
    fontname="Arial"; fontsize=12; fontcolor="#74571b";
    LOAN [label="LOAN\nКредитование", fillcolor="#fbf0cd", color="#bd9851"];
    PAY [label="PAY\nБанковские расчёты", fillcolor="#fbf0cd", color="#bd9851"];
    LOAN -> PAY [label="LoanAgreementSigned", color="#a47930", fontcolor="#7c561b"];
  }

  PHARMA [label="PHARMA\nПоставки фармы"];
  DEVICE [label="DEVICE\nЭксплуатация оборудования"];
  KPI [label="KPI\nКорпоративные показатели"];

  subgraph cluster_analytics {
    label="Утверждённые аналитические публикации"; style="rounded,filled";
    color="#a7c9b6"; fillcolor="#f4faf6"; fontname="Arial"; fontsize=12; fontcolor="#285641";
    ai_product [label="Витрина\nИспользование ИИ", fillcolor="#e3f2e8", color="#76a58a"];
    finance_product [label="Витрина\nОплаты счетов", fillcolor="#e3f2e8", color="#76a58a"];
    pharma_product [label="Витрина\nПоставки по партиям", fillcolor="#e3f2e8", color="#76a58a"];
    device_product [label="Витрина\nСостояние оборудования", fillcolor="#e3f2e8", color="#76a58a"];
    BI [label="BI-портал\nDataHub · Trino", fillcolor="#e3f2e8", color="#76a58a", ordering=in];
    ai_product -> BI:nw;
    finance_product -> BI;
    pharma_product -> BI;
    device_product -> BI:sw;
    ai_product -> finance_product -> pharma_product -> device_product [style=invis, weight=25];
  }

  bi_users [label="Аналитики доменов\nи головного офиса", fillcolor="white"];
  legacy [label="Переходный источник\nSQL Server 2008 · Apache Camel", fillcolor="white", style="rounded,dashed"];

  { rank=same; register_staff; clinicians; billing_staff; legacy; bank_clients; pharma_partner; device_partner; hq; }
  { rank=same; CLINIC; EHR; BILL; LOAN; PAY; PHARMA; DEVICE; KPI; }
  { rank=same; AI; finance_product; ai_product; pharma_product; device_product; }

  register_staff -> CLINIC [style=dashed];
  clinicians -> EHR [style=dashed];
  billing_staff -> BILL [style=dashed];
  bank_clients -> LOAN [style=dashed];
  bank_clients -> PAY [style=dashed];
  pharma_partner -> PHARMA [style=dashed, label="OHS · ACL домена"];
  device_partner -> DEVICE [style=dashed, label="OHS · ACL домена"];
  hq -> KPI [style=dashed];
  legacy -> BILL [style=dashed, label="временный ACL"];
  BI -> bi_users [style=dashed, label="доступ по роли"];

  BILL:e -> PAY:e [label="InvoiceIssued", constraint=false];
  PAY:w -> BILL:w [label="PaymentPosted\nRefundPosted", constraint=false];
  BILL -> finance_product [label="InvoiceIssued · InvoiceSettled", color="#3f8060"];
  PAY -> finance_product [label="PaymentPosted\nRefundPosted", color="#3f8060"];
  AI -> ai_product [label="AIUsageRecorded", color="#3f8060", constraint=false];
  PHARMA -> pharma_product [label="BatchDelivered", color="#3f8060"];
  DEVICE -> device_product [label="DeviceStatusChanged", color="#3f8060"];
  KPI -> BI [label="KpiDefinitionPublished", color="#3f8060"];

  register_staff -> clinicians -> billing_staff -> legacy -> bank_clients -> pharma_partner -> device_partner -> hq [style=invis, weight=15];
  CLINIC -> EHR -> BILL -> PAY -> LOAN -> PHARMA -> DEVICE -> KPI [style=invis, weight=15];
}
