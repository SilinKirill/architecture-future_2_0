digraph event_storming {
  graph [
    charset="UTF-8", rankdir=TB, newrank=true, ordering=out,
    bgcolor="white", pad=0.19, nodesep=0.20, ranksep=0.17,
    fontname="Arial", fontsize=22, fontcolor="#172539", labelloc=t,
    label="Event Storming · доменные сценарии"
  ];
  node [
    shape=box, style="rounded,filled", fontname="Arial", fontsize=11,
    fontcolor="#172539", margin="0.10,0.08", height=0.42
  ];
  edge [color="#647990", arrowsize=0.55, penwidth=1.0];

  // Общие обозначения для всех сценариев.
  { rank=same;
    legend_actor [group=actor, label="Актор / триггер", width=1.53, fillcolor="#fff5d6", color="#be9e51"];
    legend_command [group=command, label="Команда", width=1.5, fillcolor="#e3f0fd", color="#779cc2"];
    legend_aggregate [group=aggregate, label="Агрегат", width=1.65, fillcolor="#f2edf7", color="#a291b3"];
    legend_event [group=event, label="Доменное событие", width=1.92, fillcolor="#fce8d5", color="#c48a56"];
    legend_policy [group=policy, label="Политика", width=2.2, fillcolor="#eadff4", color="#a17bb8"];
    legend_subscriber [group=subscriber, label="Подписчик / проекция", width=1.77, fillcolor="#e2f1e7", color="#74a88a"];
  }
  legend_actor -> legend_command -> legend_aggregate -> legend_event -> legend_policy -> legend_subscriber [style=invis, weight=30];

  subgraph cluster_clinical {
    label="Клиника и медицинский ИИ"; labeljust=l; style="rounded,filled"; margin=12;
    color="#cbb8df"; fillcolor="#fcfaff"; fontname="Arial"; fontsize=12; fontcolor="#234059";

    { rank=same;
      visit_actor [group=actor, label="Регистратор", width=1.53, fillcolor="#fff5d6", color="#be9e51"];
      visit_command [group=command, label="Зарегистрировать\nвизит", width=1.5, fillcolor="#e3f0fd", color="#779cc2"];
      visit_aggregate [group=aggregate, label="CLINIC\nВизит", width=1.65, fillcolor="#f2edf7", color="#a291b3"];
      visit_event [group=event, label="VisitRegistered", width=1.92, fillcolor="#fce8d5", color="#c48a56"];
      visit_policy [group=policy, label="Открыть клинический\nэпизод один раз", width=2.2, fillcolor="#eadff4", color="#a17bb8"];
      visit_subscriber [group=subscriber, label="EHR\nЗакрытый канал", width=1.77, fillcolor="#f1e6fa", color="#a17bb8"];
    }
    visit_actor -> visit_command -> visit_aggregate -> visit_event -> visit_policy -> visit_subscriber;

    { rank=same;
      study_request_actor [group=actor, label="Лечащий врач", width=1.53, fillcolor="#fff5d6", color="#be9e51"];
      study_request_command [group=command, label="Подтвердить\nназначение", width=1.5, fillcolor="#e3f0fd", color="#779cc2"];
      study_request_aggregate [group=aggregate, label="EHR\nКлиническое исследование", width=1.65, fillcolor="#f2edf7", color="#a291b3"];
      study_request_event [group=event, label="ClinicalStudyRequested", width=1.92, fillcolor="#fce8d5", color="#c48a56"];
      study_request_policy [group=policy, label="Передать заявку и ссылку\nв клиническом контуре", width=2.2, fillcolor="#eadff4", color="#a17bb8"];
      study_request_subscriber [group=subscriber, label="AI\nЗакрытый канал", width=1.77, fillcolor="#f1e6fa", color="#a17bb8"];
    }
    study_request_actor -> study_request_command -> study_request_aggregate -> study_request_event -> study_request_policy -> study_request_subscriber;

    { rank=same;
      study_complete_actor [group=actor, label="Сервис ИИ", width=1.53, fillcolor="#fff5d6", color="#be9e51"];
      study_complete_command [group=command, label="Завершить анализ", width=1.5, fillcolor="#e3f0fd", color="#779cc2"];
      study_complete_aggregate [group=aggregate, label="AI\nЗадание обработки", width=1.65, fillcolor="#f2edf7", color="#a291b3"];
      study_complete_event [group=event, label="AIStudyCompleted", width=1.92, fillcolor="#fce8d5", color="#c48a56"];
      study_complete_policy [group=policy, label="Привязать результат\nк заявке по её ID", width=2.2, fillcolor="#eadff4", color="#a17bb8"];
      study_complete_subscriber [group=subscriber, label="EHR\nЗакрытый канал", width=1.77, fillcolor="#f1e6fa", color="#a17bb8"];
    }
    study_complete_actor -> study_complete_command -> study_complete_aggregate -> study_complete_event -> study_complete_policy -> study_complete_subscriber;

    { rank=same;
      ai_usage_actor [group=actor, label="Сервис ИИ", width=1.53, fillcolor="#fff5d6", color="#be9e51"];
      ai_usage_command [group=command, label="Зафиксировать\nитог окна", width=1.5, fillcolor="#e3f0fd", color="#779cc2"];
      ai_usage_aggregate [group=aggregate, label="AI\nИспользование за период", width=1.65, fillcolor="#f2edf7", color="#a291b3"];
      ai_usage_event [group=event, label="AIUsageRecorded", width=1.92, fillcolor="#fce8d5", color="#c48a56"];
      ai_usage_policy [group=policy, label="Обновить версию окна\nпо разрешённым измерениям", width=2.2, fillcolor="#eadff4", color="#a17bb8"];
      ai_usage_subscriber [group=subscriber, label="Витрина использования ИИ\n→ BI", width=1.77, fillcolor="#e2f1e7", color="#74a88a"];
    }
    ai_usage_actor -> ai_usage_command -> ai_usage_aggregate -> ai_usage_event -> ai_usage_policy -> ai_usage_subscriber;

    visit_actor -> study_request_actor -> study_complete_actor -> ai_usage_actor [style=invis, weight=30];
    visit_command -> study_request_command -> study_complete_command -> ai_usage_command [style=invis, weight=30];
    visit_aggregate -> study_request_aggregate -> study_complete_aggregate -> ai_usage_aggregate [style=invis, weight=30];
    visit_event -> study_request_event -> study_complete_event -> ai_usage_event [style=invis, weight=30];
    visit_policy -> study_request_policy -> study_complete_policy -> ai_usage_policy [style=invis, weight=30];
    visit_subscriber -> study_request_subscriber -> study_complete_subscriber -> ai_usage_subscriber [style=invis, weight=30];
  }

  subgraph cluster_finance {
    label="Счета клиники, расчёты и кредитование"; labeljust=l; style="rounded,filled"; margin=12;
    color="#e1c78c"; fillcolor="#fdfcf8"; fontname="Arial"; fontsize=12; fontcolor="#234059";

    { rank=same;
      invoice_actor [group=actor, label="Расчётчик клиники", width=1.53, fillcolor="#fff5d6", color="#be9e51"];
      invoice_command [group=command, label="Выставить счёт", width=1.5, fillcolor="#e3f0fd", color="#779cc2"];
      invoice_aggregate [group=aggregate, label="BILL\nСчёт", width=1.65, fillcolor="#f2edf7", color="#a291b3"];
      invoice_event [group=event, label="InvoiceIssued", width=1.92, fillcolor="#fce8d5", color="#c48a56"];
      invoice_policy [group=policy, label="Передать непрозрачную\nссылку, сумму и валюту", width=2.2, fillcolor="#eadff4", color="#a17bb8"];
      invoice_subscriber [group=subscriber, label="PAY и витрина\nоплат счетов", width=1.77, fillcolor="#e2f1e7", color="#74a88a"];
    }
    invoice_actor -> invoice_command -> invoice_aggregate -> invoice_event -> invoice_policy -> invoice_subscriber;

    { rank=same;
      payment_actor [group=actor, label="Плательщик\nчерез банк", width=1.53, fillcolor="#fff5d6", color="#be9e51"];
      payment_command [group=command, label="Провести платёж", width=1.5, fillcolor="#e3f0fd", color="#779cc2"];
      payment_aggregate [group=aggregate, label="PAY\nПлатёж по счёту", width=1.65, fillcolor="#f2edf7", color="#a291b3"];
      payment_event [group=event, label="PaymentPosted", width=1.92, fillcolor="#fce8d5", color="#c48a56"];
      payment_policy [group=policy, label="Учесть платёж по счёту.\nЧастичная оплата\nсохраняет остаток", width=2.2, fillcolor="#eadff4", color="#a17bb8"];
      payment_subscriber [group=subscriber, label="BILL и витрина\nоплат счетов", width=1.77, fillcolor="#e2f1e7", color="#74a88a"];
    }
    payment_actor -> payment_command -> payment_aggregate -> payment_event -> payment_policy -> payment_subscriber;

    { rank=same;
      settle_actor [group=actor, label="Политика BILL\nпосле проводки", width=1.53, fillcolor="#eadff4", color="#a17bb8"];
      settle_command [group=command, label="Закрыть счёт\nпри нулевом остатке", width=1.5, fillcolor="#e3f0fd", color="#779cc2"];
      settle_aggregate [group=aggregate, label="BILL\nСчёт", width=1.65, fillcolor="#f2edf7", color="#a291b3"];
      settle_event [group=event, label="InvoiceSettled", width=1.92, fillcolor="#fce8d5", color="#c48a56"];
      settle_policy [group=policy, label="Опубликовать переход\nв состояние погашения", width=2.2, fillcolor="#eadff4", color="#a17bb8"];
      settle_subscriber [group=subscriber, label="Витрина\nоплат счетов", width=1.77, fillcolor="#e2f1e7", color="#74a88a"];
    }
    settle_actor -> settle_command -> settle_aggregate -> settle_event -> settle_policy -> settle_subscriber;

    { rank=same;
      refund_actor [group=actor, label="Оператор банка", width=1.53, fillcolor="#fff5d6", color="#be9e51"];
      refund_command [group=command, label="Провести возврат", width=1.5, fillcolor="#e3f0fd", color="#779cc2"];
      refund_aggregate [group=aggregate, label="PAY\nПлатёж по счёту", width=1.65, fillcolor="#f2edf7", color="#a291b3"];
      refund_event [group=event, label="RefundPosted", width=1.92, fillcolor="#fce8d5", color="#c48a56"];
      refund_policy [group=policy, label="Связать с платежом и\nпересчитать остаток в BILL", width=2.2, fillcolor="#eadff4", color="#a17bb8"];
      refund_subscriber [group=subscriber, label="BILL и витрина\nоплат счетов", width=1.77, fillcolor="#e2f1e7", color="#74a88a"];
    }
    refund_actor -> refund_command -> refund_aggregate -> refund_event -> refund_policy -> refund_subscriber;

    { rank=same;
      loan_actor [group=actor, label="Кредитный специалист\nи заёмщик", width=1.53, fillcolor="#fff5d6", color="#be9e51"];
      loan_command [group=command, label="Зарегистрировать\nподписанный договор", width=1.5, fillcolor="#e3f0fd", color="#779cc2"];
      loan_aggregate [group=aggregate, label="LOAN\nКредитный договор", width=1.65, fillcolor="#f2edf7", color="#a291b3"];
      loan_event [group=event, label="LoanAgreementSigned", width=1.92, fillcolor="#fce8d5", color="#c48a56"];
      loan_policy [group=policy, label="Передать сведения расчётам\nпо внутрибанковскому контракту", width=2.2, fillcolor="#eadff4", color="#a17bb8"];
      loan_subscriber [group=subscriber, label="PAY\nЗакрытый канал", width=1.77, fillcolor="#fbefcd", color="#bf9953"];
    }
    loan_actor -> loan_command -> loan_aggregate -> loan_event -> loan_policy -> loan_subscriber;

    invoice_actor -> payment_actor -> settle_actor -> refund_actor -> loan_actor [style=invis, weight=30];
    invoice_command -> payment_command -> settle_command -> refund_command -> loan_command [style=invis, weight=30];
    invoice_aggregate -> payment_aggregate -> settle_aggregate -> refund_aggregate -> loan_aggregate [style=invis, weight=30];
    invoice_event -> payment_event -> settle_event -> refund_event -> loan_event [style=invis, weight=30];
    invoice_policy -> payment_policy -> settle_policy -> refund_policy -> loan_policy [style=invis, weight=30];
    invoice_subscriber -> payment_subscriber -> settle_subscriber -> refund_subscriber -> loan_subscriber [style=invis, weight=30];
  }

  subgraph cluster_other {
    label="Поставки, оборудование и корпоративные показатели"; labeljust=l; style="rounded,filled"; margin=12;
    color="#a7c9b6"; fillcolor="#f8fbf9"; fontname="Arial"; fontsize=12; fontcolor="#234059";

    { rank=same;
      batch_actor [group=actor, label="Фармпоставщик", width=1.53, fillcolor="#fff5d6", color="#be9e51"];
      batch_command [group=command, label="Подтвердить\nпоставку партии", width=1.5, fillcolor="#e3f0fd", color="#779cc2"];
      batch_aggregate [group=aggregate, label="PHARMA\nПоставка партии", width=1.65, fillcolor="#f2edf7", color="#a291b3"];
      batch_event [group=event, label="BatchDelivered", width=1.92, fillcolor="#fce8d5", color="#c48a56"];
      batch_policy [group=policy, label="Проецировать поставку\nпо партии и площадке", width=2.2, fillcolor="#eadff4", color="#a17bb8"];
      batch_subscriber [group=subscriber, label="Витрина поставок\n→ BI", width=1.77, fillcolor="#e2f1e7", color="#74a88a"];
    }
    batch_actor -> batch_command -> batch_aggregate -> batch_event -> batch_policy -> batch_subscriber;

    { rank=same;
      device_actor [group=actor, label="Инженер или\nсервис поставщика", width=1.53, fillcolor="#fff5d6", color="#be9e51"];
      device_command [group=command, label="Обновить статус\nоборудования", width=1.5, fillcolor="#e3f0fd", color="#779cc2"];
      device_aggregate [group=aggregate, label="DEVICE\nУстройство", width=1.65, fillcolor="#f2edf7", color="#a291b3"];
      device_event [group=event, label="DeviceStatusChanged", width=1.92, fillcolor="#fce8d5", color="#c48a56"];
      device_policy [group=policy, label="Обновить число исправных\nустройств", width=2.2, fillcolor="#eadff4", color="#a17bb8"];
      device_subscriber [group=subscriber, label="Витрина эксплуатации\n→ BI", width=1.77, fillcolor="#e2f1e7", color="#74a88a"];
    }
    device_actor -> device_command -> device_aggregate -> device_event -> device_policy -> device_subscriber;

    { rank=same;
      kpi_actor [group=actor, label="Методолог\nголовного офиса", width=1.53, fillcolor="#fff5d6", color="#be9e51"];
      kpi_command [group=command, label="Опубликовать\nопределение KPI", width=1.5, fillcolor="#e3f0fd", color="#779cc2"];
      kpi_aggregate [group=aggregate, label="KPI\nОпределение показателя", width=1.65, fillcolor="#f2edf7", color="#a291b3"];
      kpi_event [group=event, label="KpiDefinitionPublished", width=1.92, fillcolor="#fce8d5", color="#c48a56"];
      kpi_policy [group=policy, label="Подключить версию формулы\nи разрешённые измерения", width=2.2, fillcolor="#eadff4", color="#a17bb8"];
      kpi_subscriber [group=subscriber, label="BI-портал", width=1.77, fillcolor="#e2f1e7", color="#74a88a"];
    }
    kpi_actor -> kpi_command -> kpi_aggregate -> kpi_event -> kpi_policy -> kpi_subscriber;

    batch_actor -> device_actor -> kpi_actor [style=invis, weight=30];
    batch_command -> device_command -> kpi_command [style=invis, weight=30];
    batch_aggregate -> device_aggregate -> kpi_aggregate [style=invis, weight=30];
    batch_event -> device_event -> kpi_event [style=invis, weight=30];
    batch_policy -> device_policy -> kpi_policy [style=invis, weight=30];
    batch_subscriber -> device_subscriber -> kpi_subscriber [style=invis, weight=30];
  }

  // Выравнивание колонок в отдельных контурах.
  legend_actor -> visit_actor [style=invis, weight=30];
  ai_usage_actor -> invoice_actor [style=invis, weight=30];
  loan_actor -> batch_actor [style=invis, weight=30];
  legend_command -> visit_command [style=invis, weight=30];
  ai_usage_command -> invoice_command [style=invis, weight=30];
  loan_command -> batch_command [style=invis, weight=30];
  legend_aggregate -> visit_aggregate [style=invis, weight=30];
  ai_usage_aggregate -> invoice_aggregate [style=invis, weight=30];
  loan_aggregate -> batch_aggregate [style=invis, weight=30];
  legend_event -> visit_event [style=invis, weight=30];
  ai_usage_event -> invoice_event [style=invis, weight=30];
  loan_event -> batch_event [style=invis, weight=30];
  legend_policy -> visit_policy [style=invis, weight=30];
  ai_usage_policy -> invoice_policy [style=invis, weight=30];
  loan_policy -> batch_policy [style=invis, weight=30];
  legend_subscriber -> visit_subscriber [style=invis, weight=30];
  ai_usage_subscriber -> invoice_subscriber [style=invis, weight=30];
  loan_subscriber -> batch_subscriber [style=invis, weight=30];

  delivery [
    shape=note, style=filled, color="#b4c0cb", fillcolor="#f8fafc", fontsize=10,
    label="Платежи и возвраты\nСумма проведённых платежей за вычетом возвратов считается в одной валюте.\nBILL и проекция применяют факт один раз по event_id и сверяют ID платежа и версию.\nПогашение публикуется при переходе остатка к нулю. Возврат может снова открыть остаток.\n\nГраница данных\nСведения о визите, исследованиях и кредитном договоре идут по закрытым каналам.\nВитрина ИИ использует утверждённые показатели использования сервиса."
  ];
  kpi_aggregate -> delivery [style=invis, weight=30];
}
